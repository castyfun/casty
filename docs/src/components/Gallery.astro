---
// The page as it looks: each desktop screen with a phone screen beside it.
import composeDark from "../assets/desktop-compose-dark.png";
import youLight from "../assets/desktop-you-light.png";
import composeLight from "../assets/phone-compose-light.png";
import mentionsDark from "../assets/phone-mentions-dark.png";

interface Props {
  /** Captions, in this order: account page, compose box, mentions on a phone, compose on a phone. */
  captions: [string, string, string, string];
}
const { captions } = Astro.props;
// Laid out in rows of a desktop screen and a phone screen; the captions keep their order.
const shots = [
  { img: youLight, kind: "desktop", caption: 0 },
  { img: mentionsDark, kind: "phone", caption: 2 },
  { img: composeDark, kind: "desktop", caption: 1 },
  { img: composeLight, kind: "phone", caption: 3 },
];
---

<div class="gallery not-content">
  {
    shots.map(({ img, kind, caption }) => (
      <figure class={kind}>
        <img src={img.src} width={img.width / 2} height={img.height / 2} alt={captions[caption]} loading="lazy" decoding="async" />
        <figcaption>{captions[caption]}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    margin: 1.5rem 0;
  }
  figure {
    margin: 0;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline-shade);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.14);
  }
  .desktop img {
    border-radius: 12px;
  }
  .phone img {
    border-radius: 22px;
  }
  figcaption {
    margin-top: 0.625rem;
    color: var(--sl-color-gray-3);
    font: 0.8125rem / 1.4 var(--sl-font-system-mono);
  }
  @media (max-width: 36rem) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .phone {
      max-width: 18rem;
      margin-inline: auto;
    }
  }
</style>
