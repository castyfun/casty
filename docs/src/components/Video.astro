---
// The 59-second film: the three commands, then the page on a laptop and a phone. Subtitles in
// every language of the site, the page's own shown by default; the vertical cut is a link.
interface Props {
  /** The page's locale, as in the subtitle file names: en, ru, zh-cn, es, fr, ar. */
  lang: string;
  /** The link text for the vertical cut, in the page's language. */
  vertical: string;
}
const { lang, vertical } = Astro.props;
const media = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}media/`;
const tracks = [
  ["en", "English"],
  ["ru", "Русский"],
  ["zh-cn", "简体中文"],
  ["es", "Español"],
  ["fr", "Français"],
  ["ar", "العربية"],
];
---

<figure class="video not-content">
  <video controls preload="none" playsinline width="1920" height="1080" poster={`${media}casty-poster.jpg`}>
    <source src={`${media}casty.mp4`} type="video/mp4" />
    {
      tracks.map(([code, label]) => (
        <track kind="subtitles" src={`${media}casty.${code}.vtt`} srclang={code} label={label} default={code === lang} />
      ))
    }
  </video>
  <figcaption><a href={`${media}casty-vertical.mp4`}>{vertical}</a></figcaption>
</figure>

<style>
  .video {
    margin: 1.5rem 0 0.5rem;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 14px;
    background: #121211;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.18);
  }
  figcaption {
    margin-top: 0.625rem;
    font: 0.8125rem var(--sl-font-system-mono);
  }
  figcaption a {
    color: var(--sl-color-gray-3);
  }
</style>
