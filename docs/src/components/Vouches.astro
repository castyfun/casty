---
// People who went through the tutorial and said so on Farcaster, quoted from their casts.
const vouches = [
  {
    handle: "alxsharuk",
    url: "https://farcaster.xyz/alxsharuk/0x7516b74d",
    quote:
      "…so I set it up on a server with a synced node. And it actually works, this message was sent from it.",
  },
  {
    handle: "kamilaa",
    url: "https://farcaster.xyz/kamilaa/0xead54ff7",
    quote: "…then set up his client. it worked. okay, fine, it's maybe cool",
  },
];
---

<div class="vouches not-content">
  {
    vouches.map((v) => (
      <a class="vouch" href={v.url} target="_blank" rel="noopener noreferrer">
        <blockquote>{v.quote}</blockquote>
        <span class="who">@{v.handle} on Farcaster</span>
      </a>
    ))
  }
</div>

<style>
  .vouches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    margin: 1rem 0 0.5rem;
  }
  .vouch {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-left: 3px solid var(--sl-color-accent);
    border-radius: 12px;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .vouch:hover {
    border-color: var(--sl-color-accent);
  }
  blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .who {
    color: var(--sl-color-gray-3);
    font: 0.8125rem var(--sl-font-system-mono);
  }
</style>
