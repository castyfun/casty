# Written by casty scripts/1-node.sh serve. Builds the casty client from the source shipped
# next to this file and runs `casty serve` behind the proxy that ends HTTPS.
FROM node:22-alpine
WORKDIR /app
COPY . .
RUN corepack enable && pnpm install --frozen-lockfile --prod --filter @casty/client && pnpm --filter @casty/client build
ENV XDG_CONFIG_HOME=/config
EXPOSE 3390
ENTRYPOINT ["node", "client/dist/casty.js"]
