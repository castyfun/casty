# Written by casty scripts/1-node.sh. Only keys missing from ~/snapchain/.env are added.
AGREE_NO_REWARDS_FOR_ME=true
HUB_OPERATOR_FID={{FID}}
{{SKIP_CRONTAB}}
# Grafana's admin login, random: snapchain.sh reads GRAFANA_CREDS, and Grafana is given
# GRAFANA_PASSWORD by docker-compose.override.yml on its first start.
GRAFANA_CREDS=admin:{{GRAFANA_PASSWORD}}
GRAFANA_PASSWORD={{GRAFANA_PASSWORD}}
# The compose file publishes statsd at these addresses: the host's loopback, not every interface.
STATSD_PUBLISH=127.0.0.1:8125
STATSD_ADMIN_PUBLISH=127.0.0.1:8126
